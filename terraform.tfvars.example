###############################################################################
# terraform.tfvars.example — Modèle des paramètres communs à toutes les classes
###############################################################################
#
# Copier ce fichier en terraform.tfvars et compléter :
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars est chargé AUTOMATIQUEMENT par Terraform. Il contient le
# token API : il est exclu de Git (.gitignore), ne jamais le versionner.
###############################################################################

# --- Connexion ----------------------------------------------------------------
# Adresse INTERNE d'un nœud, port 8006, joignable depuis la machine qui lance
# Terraform. Ne pas utiliser https://siohyp2.educ-valadon-limoges.fr/ : cette
# adresse passe par le proxy Microsoft Entra (connexion Microsoft obligatoire)
# et renvoie une page HTML au lieu de l'API (« invalid character '<' »).
# Test :  curl -sk -H "Authorization: PVEAPIToken=<token>" https://<IP>:8006/api2/json/version
proxmox_endpoint  = "https://10.187.36.12:8006/" # à adapter
proxmox_api_token = "terraform@pve!tf=00000000-0000-0000-0000-000000000000"

# --- Nœud cible ---------------------------------------------------------------
# Seul siohyp2 porte les bridges étudiants (siohyp1 et siohyp3 n'en ont aucun).
node_name = "siohyp2"

# --- Templates : VMID + nœud qui le porte ---------------------------------------
# Vérifier avec : ls /etc/pve/nodes/*/qemu-server/{404,267,270}.conf
# Conseil : regrouper les templates sur le nœud cible (qm migrate 404 siohyp2)
# évite les erreurs « volume does not exist » lors des clones entre nœuds.
templates = {
  sns    = { vm_id = 404, node = "siohyp1" } # Modele-SNS-4.33  (NFS-NAS, qcow2, BIOS)
  winsrv = { vm_id = 267, node = "siohyp2" } # SRV2025MODELE    (NFS-NAS, qcow2, UEFI)
  wincli = { vm_id = 270, node = "siohyp2" } # WIN11CLIENT      (NFS-NAS, qcow2, UEFI + TPM)
  mint   = { vm_id = 280, node = "siohyp2" } # linuxmintmodele  (NFS-NAS, qcow2, BIOS)
  kali   = { vm_id = 283, node = "siohyp2" } # kalilinuxmodele  (NFS-NAS, qcow2, BIOS)

  mutillidae = { vm_id = 286, node = "siohyp2" } # srvmutillidaemodele (nœud et BIOS à vérifier)
}

# --- Clonage --------------------------------------------------------------------
# Les 3 templates sont sur NFS-NAS (stockage partagé) : clones liés possibles
# depuis n'importe quel nœud.
linked_clone    = true
clone_datastore = null # ex. "NFS-NAS" si linked_clone = false

# --- Réseau ---------------------------------------------------------------------
# Bridges étudiants existants : ETU01 = vmbr401..405, ETU02 = vmbr406..410…
bridge_base          = 400
bridges_par_etudiant = 5

# Interface « out » des SNS
wan_bridge  = "vmbr134" # BTSSIO BYOD Wifi (bond0.134), accès Internet du lycée
wan_vlan_id = null
